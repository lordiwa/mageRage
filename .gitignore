# ---- Godot 4+ ----
# Godot's auto-generated cache/import folder
.godot/
# Legacy import folder
.import/
# Mono / .NET (only if using C# in Godot)
.mono/
data_*/
mono_crash.*.json
# Imported translations (generated from CSV)
*.translation

# ---- Export artifacts ----
export.cfg
export_presets.cfg
build/
*.exe
*.pck
*.zip

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.tmp

# ---- Claude Code local settings (machine-specific) ----
.claude/settings.local.json

# ---- Raw art drop (UNTRACKED on purpose) ----
# Purchased/third-party source art lives here for local reference only.
# Licenses likely forbid redistributing raw sources (.psd/.ai/.eps/.kra), so do
# NOT commit this folder. Curate only the licensed PNG exports we actually use
# into assets/ (consider Git-LFS). See docs/ART-ASSETS.md.
AssetBundles/
